<h1 class="text-2xl font-bold mb-6">대회 설정 수정</h1>

<%= form_with model: @race, url: admin_race_path do |f| %>
  <div class="space-y-4">
    <div>
      <%= f.label :registration_deadline, "신청 마감일", class: "block text-sm font-medium text-gray-900 mb-1" %>
      <%= f.datetime_local_field :registration_deadline,
            class: "w-full border border-gray-200 rounded-lg px-3 py-2.5 text-base focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" %>
    </div>

    <div class="mt-6">
      <%= f.submit "저장",
            class: "w-full bg-primary hover:bg-primary-hover text-white font-medium py-3 px-6 rounded-lg transition-colors cursor-pointer" %>
    </div>
  </div>
<% end %>
