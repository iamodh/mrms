<h1 class="text-2xl font-bold mb-4">신청자 목록</h1>

<div class="flex flex-wrap items-center gap-2 mb-4">
  <%= form_with url: admin_registrations_path, method: :get, local: true, class: "flex flex-wrap items-center gap-2" do |f| %>
    <%= select_tag :course_id,
      options_for_select(
        [["전체 코스", ""]] + @courses.map { |c| [c.name, c.id] },
        params[:course_id]
      ),
      onchange: "this.form.submit()",
      class: "border border-gray-200 rounded-lg px-3 py-2 text-sm" %>

    <%= select_tag :status,
      options_for_select(
        [["전체 상태", ""], ["신청", "applied"], ["취소", "canceled"], ["환불", "refunded"]],
        params[:status]
      ),
      onchange: "this.form.submit()",
      class: "border border-gray-200 rounded-lg px-3 py-2 text-sm" %>

    <%= select_tag :sort,
      options_for_select(
        [["최신순", "newest"], ["이름순", "name_asc"], ["이름역순", "name_desc"]],
        params[:sort]
      ),
      onchange: "this.form.submit()",
      class: "border border-gray-200 rounded-lg px-3 py-2 text-sm" %>
  <% end %>

  <%= link_to admin_registrations_path(format: :xlsx, course_id: params[:course_id], status: params[:status], sort: params[:sort]),
    class: "ml-auto inline-flex items-center gap-1.5 border border-gray-200 rounded-lg px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50" do %>
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z" fill="#16a34a"/>
      <path d="M14 2v6h6" fill="#15803d"/>
      <text x="12" y="17" text-anchor="middle" font-size="7" font-weight="bold" fill="white">X</text>
    </svg>
    엑셀 다운로드
  <% end %>
</div>

<div class="overflow-x-auto">
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-gray-200">
        <th class="text-left py-3 px-3 font-semibold text-gray-900">이름</th>
        <th class="text-left py-3 px-3 font-semibold text-gray-900">전화번호</th>
        <th class="text-left py-3 px-3 font-semibold text-gray-900">코스</th>
        <th class="text-left py-3 px-3 font-semibold text-gray-900">상태</th>
        <th class="text-left py-3 px-3 font-semibold text-gray-900">신청일</th>
      </tr>
    </thead>
    <tbody>
      <% @registrations.each do |registration| %>
        <tr class="border-b border-gray-100 hover:bg-gray-50">
          <td class="py-3 px-3"><%= registration.name %></td>
          <td class="py-3 px-3"><%= registration.formatted_phone_number %></td>
          <td class="py-3 px-3"><%= registration.course.name %></td>
          <td class="py-3 px-3">
            <% badge_class = case registration.status
              when "applied" then "bg-green-50 text-green-700"
              when "canceled" then "bg-gray-100 text-gray-600"
              when "refunded" then "bg-red-50 text-red-700"
              end %>
            <span class="inline-block px-2 py-0.5 text-xs font-medium rounded-full <%= badge_class %>">
              <%= registration.status_label %>
            </span>
          </td>
          <td class="py-3 px-3 text-gray-500"><%= registration.created_at.strftime("%Y-%m-%d %H:%M") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
