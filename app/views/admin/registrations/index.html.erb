<h1>신청자 목록</h1>

<div class="filters">
  <div class="sort-links">
    정렬:
    <%= link_to "최신순", admin_registrations_path(sort: "newest", course_id: params[:course_id], status: params[:status]) %> |
    <%= link_to "이름 ▲", admin_registrations_path(sort: "name_asc", course_id: params[:course_id], status: params[:status]) %> |
    <%= link_to "이름 ▼", admin_registrations_path(sort: "name_desc", course_id: params[:course_id], status: params[:status]) %>
  </div>

  <%= form_with url: admin_registrations_path, method: :get, local: true do |f| %>
    <%= hidden_field_tag :sort, params[:sort] %>

    <%= select_tag :course_id,
      options_for_select(
        [["전체 코스", ""]] + @courses.map { |c| [c.name, c.id] },
        params[:course_id]
      ),
      class: "course-filter",
      onchange: "this.form.submit()" %>

    <%= select_tag :status,
      options_for_select(
        [["전체 상태", ""], ["신청", "applied"], ["취소", "canceled"], ["환불", "refunded"]],
        params[:status]
      ),
      class: "status-filter",
      onchange: "this.form.submit()" %>
  <% end %>
</div>

<table class="registrations-table">
  <thead>
    <tr>
      <th>이름</th>
      <th>전화번호</th>
      <th>코스</th>
      <th>상태</th>
      <th>신청일</th>
    </tr>
  </thead>
  <tbody>
    <% @registrations.each do |registration| %>
      <tr class="registration-row">
        <td class="registration-name"><%= registration.name %></td>
        <td><%= registration.phone_number %></td>
        <td><%= registration.course.name %></td>
        <td><%= registration.status %></td>
        <td><%= registration.created_at.strftime("%Y-%m-%d %H:%M") %></td>
      </tr>
    <% end %>
  </tbody>
</table>
