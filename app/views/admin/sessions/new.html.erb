<h1 class="text-2xl font-bold mb-6">관리자 로그인</h1>

<%= form_with url: admin_login_path do |f| %>
  <div class="space-y-4">
    <div>
      <%= f.label :id, "아이디", class: "block text-sm font-medium text-gray-900 mb-1" %>
      <%= f.text_field :id,
            class: "w-full border border-gray-200 rounded-lg px-3 py-2.5 text-base focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary placeholder:text-gray-400" %>
    </div>

    <div>
      <%= f.label :password, "비밀번호", class: "block text-sm font-medium text-gray-900 mb-1" %>
      <%= f.password_field :password,
            class: "w-full border border-gray-200 rounded-lg px-3 py-2.5 text-base focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary placeholder:text-gray-400" %>
    </div>

    <div class="mt-6">
      <%= f.submit "로그인",
            class: "w-full bg-primary hover:bg-primary-hover text-white font-medium py-3 px-6 rounded-lg transition-colors cursor-pointer" %>
    </div>
  </div>
<% end %>
