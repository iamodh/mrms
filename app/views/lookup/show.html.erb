<h1>신청 내역</h1>

<p class="confirmation-code"><%= @registration.confirmation_code %></p>
<p>이름: <%= @registration.name %></p>
<p>코스: <%= @registration.course.name %></p>
<p>상태: <%= @registration.status %></p>

<% if @registration.cancelable? %>
  <%= button_to "신청 취소", lookup_path, method: :delete, params: { confirmation_code: @registration.confirmation_code, name: @registration.name } %>
<% end %>

<%= link_to "홈으로 돌아가기", root_path %>
